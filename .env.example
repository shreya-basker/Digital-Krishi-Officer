# Copy to .env and fill in. The app reads this file from the project root.

# Local PostgreSQL database (create it first: createdb -U postgres agrisathi)
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/agrisathi

# Any long random string; signs login tokens
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Optional: enables the AI chat and non-English recommendation text
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: live Agmarknet mandi prices from https://data.gov.in (sample prices are used without it)
DATA_GOV_API_KEY=
